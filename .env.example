# Copy to .env.local for local dev, and set the same keys in Vercel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Generate a long random value, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Cloudflare R2 (content + media storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=mickey-photography
# Public base URL of the bucket (r2.dev or a custom domain), no trailing slash
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
